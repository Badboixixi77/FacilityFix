# Database Configuration
# SQLite is used locally for instant out-of-the-box setup
# Swap provider to "postgresql" in prisma/schema.prisma for production (Neon, Supabase, Render)
DATABASE_URL="file:./dev.db"

# Session Authentication Secret
JWT_SECRET="facilityfix-super-secret-key-change-in-production-987654321!"

# Environment
NODE_ENV="development"
